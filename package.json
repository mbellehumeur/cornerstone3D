{
  "name": "root",
  "description": "Cornerstone.js Monorepo Root",
  "private": true,
  "repository": "https://github.com/cornerstonejs/cornerstone3D",
  "sideEffects": false,
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.5.2"
  },
  "scripts": {
    "api-check": "pnpm -r --filter=!docs run api-check",
    "format-check": "cross-env NODE_OPTIONS=--max_old_space_size=32896 prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\" || exit 0",
    "build": "pnpm -r --filter=!docs run build && pnpm --filter @cornerstonejs/dicom-image-loader run build:loader",
    "build:esm": "pnpm -r --filter=!docs run build:esm",
    "build:esm:watch": "pnpm run build:esm && pnpm -r --filter=!docs --parallel run build:esm:watch",
    "watch": "pnpm run build:esm:watch",
    "build:update-api": "echo not needed anymore",
    "clean": "pnpm -r run clean",
    "clean:deep": "pnpm -r run clean:deep",
    "example": "node ./utils/ExampleRunner/example-runner-cli.js",
    "all-examples": "node ./utils/ExampleRunner/build-all-examples-cli.js --fromRoot",
    "build-all-examples": "cross-env NODE_OPTIONS=--max_old_space_size=32896 node ./utils/ExampleRunner/build-all-examples-cli.js --build --fromRoot || (echo 'Build failed - likely due to memory constraints' && exit 1)",
    "serve-static-examples": "pnpm dlx serve .static-examples --listen 3333",
    "build-and-serve-static-examples": "cross-env NODE_OPTIONS=--max_old_space_size=32896 pnpm run build-all-examples && pnpm run serve-static-examples",
    "build:all": "pnpm -r --filter=!docs run build:all",
    "validate:packaging": "node scripts/validate-esm-packaging.mjs",
    "dev": "pnpm run all-examples",
    "docs": "pnpm -r run docs",
    "docs:watch": "pnpm -r run docs:watch",
    "install:update-lockfile": "pnpm install --no-frozen-lockfile",
    "install:frozen": "pnpm install",
    "audit": "pnpm audit",
    "preinstall": "node preinstall.js",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "commit:prepare": "pnpm run test:ci && pnpm run test:unit",
    "start": "pnpm run dev",
    "test:e2e:coverage": "nyc --reporter=html pnpm run test:e2e:ci",
    "test:e2e:ci": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots -g shouldUpdateThis",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:vitest:browser": "vitest --config vitest.browser.config.ts --browser --run --browser.headless",
    "test:vitest:browser:update": "vitest --config vitest.browser.config.ts --browser --run --browser.headless --update",
    "test:vitest:browser:ui": "vitest --config vitest.browser.config.ts --browser",
    "test:firefox": "karma start ./karma.conf.js --browsers Firefox",
    "test:chrome": "karma start ./karma.conf.js --browsers Chrome",
    "test:dev": "karma start",
    "test:ci": "karma start --single-run",
    "test:unit:ci": "pnpm run test:unit && pnpm run test:ci",
    "test": "karma start",
    "test:unit": "jest --collectCoverage",
    "test:unit:no-coverage": "jest",
    "rebuild:canvas": "npm rebuild canvas",
    "test:debug": "karma start ./karma.conf.js --browsers Chrome --no-single-run",
    "lint-staged": "lint-staged",
    "lint": "oxlint packages/**/src --quiet",
    "webpack:watch": "pnpm -r --filter=!docs run webpack:watch"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@babel/core": "7.26.10",
    "@babel/plugin-external-helpers": "7.25.9",
